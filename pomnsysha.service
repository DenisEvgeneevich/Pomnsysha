[Unit]
Description=Pomnsysha Backend Service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/pomnsysha/backend
Environment="PATH=/var/www/pomnsysha/venv/bin"
Environment="HOST=127.0.0.1"
Environment="PORT=8000"
Environment="REDIRECT_URI=https://example.com/oauth2/callback"
Environment="CORS_ORIGINS=https://example.com"
Environment="DATABASE_URL=sqlite:///./app.db"
Environment="DEBUG=false"
ExecStart=/var/www/pomnsysha/venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pomnsysha-backend

[Install]
WantedBy=multi-user.target



